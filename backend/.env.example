# Copy this file to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Image model used for generating and editing motifs (check AI Studio for the newest one)
IMAGE_MODEL=gemini-nano-banana-2.1
# Text model used for captions
TEXT_MODEL=gemini-2.5-flash

# 1 = never call Gemini, use fake local images (free, for testing the UI)
MOCK_AI=0
